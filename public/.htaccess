# Single-page app on Apache: serve index.html for app routes such as
# /partners or /projects/12 so direct links and page refreshes work.
# Real files (JS, CSS, images, sw.js, manifest.json) are still served as-is.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule !mod_rewrite.c>
  FallbackResource /index.html
</IfModule>
